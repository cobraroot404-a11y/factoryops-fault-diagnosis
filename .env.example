# Copy this file to .env and fill in random local-only secrets, or just run
# scripts/generate-local-env.sh to do it automatically. .env is gitignored —
# never commit it. Nothing here is a paid/hosted credential; every service
# these values configure runs on your own machine via Docker Compose.

POSTGRES_USER=factoryops
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=factoryops

RABBITMQ_DEFAULT_USER=factoryops
RABBITMQ_DEFAULT_PASS=changeme-local-only

JWT_SECRET=changeme-local-only-random-string

GRAFANA_ADMIN_PASSWORD=changeme-local-only

SEED_DEMO_PASSWORD=FactoryOps!Demo1
